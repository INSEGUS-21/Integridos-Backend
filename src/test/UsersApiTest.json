    {
      "name": "6. POST - Login Correcto (carlos99)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const secret = pm.collectionVariables.get(\"secret_key\") || \"secret\";",
              "const rawBody = pm.request.body.raw || \"\";",
              "const mensaje = timestamp + \".\" + nonce + \".\" + rawBody;",
              "const hmac = CryptoJS.HmacSHA256(mensaje, secret).toString(CryptoJS.enc.Hex);",
              "pm.variables.set(\"req_ts\", timestamp);",
              "pm.variables.set(\"req_nonce\", nonce);",
              "pm.variables.set(\"req_hmac\", hmac);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login correcto (Status 200)\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    const token = pm.response.json().token;",
              "    pm.test(\"Devuelve un token JWT válido\", function () { pm.expect(token).to.be.a('string'); });",
              "    pm.collectionVariables.set(\"jwt_token\", token);",
              "}",
              "pm.collectionVariables.set(\"replay_ts\", pm.variables.get(\"req_ts\"));",
              "pm.collectionVariables.set(\"replay_nonce\", pm.variables.get(\"req_nonce\"));",
              "pm.collectionVariables.set(\"replay_hmac\", pm.variables.get(\"req_hmac\"));",
              "pm.collectionVariables.set(\"replay_body\", pm.request.body.raw);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "nonce", "value": "{{req_nonce}}", "type": "text" },
          { "key": "timestamp", "value": "{{req_ts}}", "type": "text" },
          { "key": "hmac", "value": "{{req_hmac}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"carlos99\", \"password\": \"124682e4ba20b7e43a7379d8dc80c229bb9a70e07be3445a57efaf3637119ed3\"}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [ "{{base_url}}" ],
          "path": [ "login" ]
        }
      }
    },
