    {
      "name": "6. ERROR - Ataque Caducado (Timestamp > 5 min)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const expired_ts = (Math.floor(Date.now() / 1000) - 400).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const secret = pm.collectionVariables.get(\"secret_key\") || \"secret\";",
              "const rawBody = pm.request.body.raw || \"\";",
              "",
              "const mensaje = expired_ts + \".\" + nonce + \".\" + rawBody;",
              "const hmac = CryptoJS.HmacSHA256(mensaje, secret).toString(CryptoJS.enc.Hex);",
              "",
              "pm.variables.set(\"exp_ts\", expired_ts);",
              "pm.variables.set(\"exp_nonce\", nonce);",
              "pm.variables.set(\"exp_hmac\", hmac);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Bloquea Caducidad (Status 400)\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Mensaje indica Nonce inválido\", function () { pm.expect(pm.response.text()).to.include(\"Nonce is not valid\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "nonce",
            "value": "{{exp_nonce}}",
            "type": "text"
          },
