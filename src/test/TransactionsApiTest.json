        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Bloquea fallo de integridad (Status 403)\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"Mensaje indica problema de HMAC\", function () { pm.expect(pm.response.text()).to.include(\"HMAC is not the same\"); });"
            ],
            "type": "text/javascript"
          }
        }
