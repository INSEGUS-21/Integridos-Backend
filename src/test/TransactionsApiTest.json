{
  "info": {
    "name": "Transactions API ",
    "description": "Coleccion de postman para probar la api de transacciones de forma exhaustiva",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0a. SETUP - Registrar Usuario de Pruebas",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const secret = pm.collectionVariables.get(\"secret_key\") || \"secret\";",
              "const rawBody = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : \"\";",
              "const mensaje = timestamp + \".\" + nonce + \".\" + rawBody;",
              "const hmac = CryptoJS.HmacSHA256(mensaje, secret).toString(CryptoJS.enc.Hex);",
              "pm.variables.set(\"req_ts\", timestamp);",
              "pm.variables.set(\"req_nonce\", nonce);",
              "pm.variables.set(\"req_hmac\", hmac);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Usuario registrado (201) o ya existía (409)\", function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "    if (pm.response.code === 201) {",
              "        try {",
              "            const resData = pm.response.json();",
              "            const uId = resData.userId || resData._id || (resData.user && (resData.user._id || resData.user.id));",
              "            if (uId) { pm.collectionVariables.set(\"user_id\", uId); }",
              "        } catch (e) {",
              "            // El servidor devolvió texto plano (ej. \"user created\")",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "nonce", "value": "{{req_nonce}}", "type": "text" },
          { "key": "timestamp", "value": "{{req_ts}}", "type": "text" },
          { "key": "hmac", "value": "{{req_hmac}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"user_transactions_test\", \"password\": \"hash_password_simulado_123\"}"
        },
        "url": {
          "raw": "{{base_url}}/register",
          "host": [ "{{base_url}}" ],
          "path": [ "register" ]
        }
      }
    },
    {
      "name": "0b. SETUP - Login para Obtener Token JWT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const secret = pm.collectionVariables.get(\"secret_key\") || \"secret\";",
              "const rawBody = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : \"\";",
              "const mensaje = timestamp + \".\" + nonce + \".\" + rawBody;",
              "const hmac = CryptoJS.HmacSHA256(mensaje, secret).toString(CryptoJS.enc.Hex);",
              "pm.variables.set(\"req_ts\", timestamp);",
              "pm.variables.set(\"req_nonce\", nonce);",
              "pm.variables.set(\"req_hmac\", hmac);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login correcto (Status 200)\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    let resData;",
              "    try { resData = pm.response.json(); } catch(e) {}",
              "    if (resData) {",
              "        const token = resData.token;",
              "        pm.test(\"Token JWT obtenido correctamente\", function () { pm.expect(token).to.be.a('string'); });",
              "        if (token) {",
              "            pm.collectionVariables.set(\"jwt_token\", token);",
              "            let uId = resData.userId || resData._id || (resData.user && (resData.user._id || resData.user.id));",
              "            if (!uId) {",
              "                try {",
              "                    const payload = JSON.parse(atob(token.split('.')[1]));",
              "                    uId = payload.id || payload._id || payload.userId || payload.sub;",
              "                } catch(e) {}",
              "            }",
              "            if (uId) { pm.collectionVariables.set(\"user_id\", uId); }",
              "        }",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "nonce", "value": "{{req_nonce}}", "type": "text" },
          { "key": "timestamp", "value": "{{req_ts}}", "type": "text" },
          { "key": "hmac", "value": "{{req_hmac}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"user_transactions_test\", \"password\": \"hash_password_simulado_123\"}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [ "{{base_url}}" ],
          "path": [ "login" ]
        }
      }
    },
