    {
      "name": "3. POST - Creación Correcta 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const secret = pm.collectionVariables.get(\"secret_key\") || \"secret\";",
              "const rawBody = pm.request.body.raw || \"\";",
              "",
              "const mensaje = timestamp + \".\" + nonce + \".\" + rawBody;",
              "const hmac = CryptoJS.HmacSHA256(mensaje, secret).toString(CryptoJS.enc.Hex);",
              "",
              "pm.variables.set(\"req_ts\", timestamp);",
              "pm.variables.set(\"req_nonce\", nonce);",
              "pm.variables.set(\"req_hmac\", hmac);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transacción 1 creada con éxito (200)\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "nonce",
            "value": "{{req_nonce}}",
            "type": "text"
          },
          {
            "key": "timestamp",
            "value": "{{req_ts}}",
            "type": "text"
          },
          {
            "key": "hmac",
            "value": "{{req_hmac}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"origin_account\": \"ES111\",\"destination_account\": \"ES222\",\"amount\": 100,\"currency\": \"EUR\"}"
        },
        "url": {
          "raw": "{{base_url}}/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "transactions"
          ]
        }
      }
    },
